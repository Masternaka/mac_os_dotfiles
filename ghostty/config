#############################################################
#                   GHOSTTY CONFIG                         #
#############################################################

# ~/.config/ghostty/config

# ── Apparence ──────────────────────────────────────────────

# Thème
theme = dark:Catppuccin Mocha,light:Catppuccin Latte

# Police
font-family = "JetBrainsMono Nerd Font"
font-size = 14
font-thicken = true

# Transparence & flou
background-opacity = 0.85
background-opacity-cells = true
background-blur = macos-glass-regular

# Marges internes
window-padding-x = 12
window-padding-y = 12

# ── Fenêtre ────────────────────────────────────────────────
macos-titlebar-style = transparent
window-decoration = auto
initial-window = true
quit-after-last-window-closed = true
title = ""
macos-window-buttons = visible
macos-window-shadow = true
resize-overlay = after-first
resize-overlay-position = bottom-right

# Taille au démarrage
window-width  = 135
window-height = 35
#window-position-x =
#window-position-y =
window-save-state = default

# ── Curseur ────────────────────────────────────────────────
cursor-style = block
cursor-style-blink = true
cursor-click-to-move = true
# Conserve le curseur en bloc à l'invite du shell.
shell-integration-features = no-cursor

# ── Défilement ─────────────────────────────────────────────
scrollback-limit = 10000
scrollbar = system

# ── Onglets & splits ───────────────────────────────────────
window-new-tab-position = end
unfocused-split-opacity = 0.85
split-divider-color = #c6a0f6

# ── Comportement ───────────────────────────────────────────
confirm-close-surface = true
bell-features = attention
macos-dock-drop-behavior = new-window
macos-secure-input-indication = true
macos-titlebar-proxy-icon = visible

# ── Notifications et son ───────────────────────────────────
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 15s


# ── Matériel ───────────────────────────────────────────────

# Souris
mouse-hide-while-typing = true
focus-follows-mouse = false
right-click-action = context-menu

# Clavier
macos-option-as-alt = left

# == LIENS & PRESSE-PAPIER ==
link-url = true
link-previews = true
copy-on-select = true
clipboard-trim-trailing-spaces = true
clipboard-paste-bracketed-safe = true

# ── Raccourcis clavier (ghostty +list-actions) ───────────────────────────────
keybind = cmd+enter=toggle_fullscreen
keybind = cmd+shift+h=goto_split:left
keybind = cmd+shift+l=goto_split:right
keybind = cmd+shift+k=goto_split:top
keybind = cmd+shift+j=goto_split:bottom

# Onglets
keybind = cmd+t=new_tab
keybind = cmd+w=close_surface
keybind = cmd+shift+left=move_tab:-1
keybind = cmd+shift+right=move_tab:+1
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab
# Renommer l'onglet courant
keybind = cmd+shift+i=prompt_tab_title

# Splits
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+shift+enter=toggle_split_zoom

# Redimensionnement des divisions avec Cmd+Option et les flèches
keybind = cmd+alt+left=resize_split:left,20
keybind = cmd+alt+right=resize_split:right,20
keybind = cmd+alt+up=resize_split:up,20
keybind = cmd+alt+down=resize_split:down,20

# Navigation entre les commandes dans l'historique
keybind = cmd+up=jump_to_prompt:-1
keybind = cmd+down=jump_to_prompt:1

# Rechercher le texte sélectionné et ouvrir l'historique dans l'éditeur
keybind = cmd+shift+f=search_selection
keybind = cmd+shift+s=write_scrollback_file:open

# Divers
keybind = cmd+shift+e=equalize_splits
# Réinitialisation du terminal (en cas d'affichage bloqué)
keybind = cmd+shift+r=reset
