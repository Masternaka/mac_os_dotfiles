#############################################################
#                   GHOSTTY CONFIG                         #
#############################################################

# ~/.config/ghostty/config

# ── Apparence ──────────────────────────────────────────────

# Thème
theme = dark:Catppuccin Mocha,light:Catppuccin Latte

# Police
font-family = "JetBrainsMono Nerd Font"
font-size = 14
font-thicken = true

# Transparence & flou
background-opacity = 0.85
background-opacity-cells = true
background-blur = macos-glass-regular

# Marges internes
window-padding-x = 12
window-padding-y = 12

# ── Fenêtre ────────────────────────────────────────────────
macos-titlebar-style = transparent
window-decoration = auto
initial-window = true
title = ""
macos-window-buttons = visible
macos-window-shadow = true
resize-overlay = always
resize-overlay-position = center

# Taille au démarrage
window-width  = 150
window-height = 40
#window-position-x =
#window-position-y =
window-save-state = default

# ── Curseur ────────────────────────────────────────────────
cursor-style = block
cursor-style-blink = true

# ── Défilement ─────────────────────────────────────────────
scrollback-limit = 10000
scrollbar = system

# ── Onglets & splits ───────────────────────────────────────
window-new-tab-position = end
unfocused-split-opacity = 0.85
split-divider-color = #c6a0f6

# ── Comportement ───────────────────────────────────────────
confirm-close-surface = true
quick-terminal-position = top
quick-terminal-size = 20%
quick-terminal-screen = main
quick-terminal-autohide = false
quick-terminal-space-behavior = move
quick-terminal-keyboard-interactivity = on-demand
bell-features = attention
macos-dock-drop-behavior = new-window
macos-secure-input-indication = true
macos-titlebar-proxy-icon = visible

# ── Notifications et son ───────────────────────────────────
notify-on-command-finish = unfocused
notify-on-command-finish-action = bell
notify-on-command-finish-after = 5s


# ── Matériel ───────────────────────────────────────────────

# Souris
mouse-hide-while-typing = true
focus-follows-mouse = false
right-click-action = context-menu

# Clavier
macos-option-as-alt = left

# == LIENS & PRESSE-PAPIER ==
link-url = true
link-previews = true
copy-on-select = true
clipboard-trim-trailing-spaces = true
clipboard-paste-bracketed-safe = true

# ── Raccourcis clavier (ghostty +list-actions) ───────────────────────────────
keybind = cmd+enter=toggle_fullscreen
keybind = cmd+shift+h=goto_split:left
keybind = cmd+shift+l=goto_split:right
keybind = cmd+shift+k=goto_split:top
keybind = cmd+shift+j=goto_split:bottom

# Onglets
keybind = cmd+t=new_tab
keybind = cmd+w=close_surface
keybind = cmd+shift+left=move_tab:-1
keybind = cmd+shift+right=move_tab:+1
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab

# Splits
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+shift+enter=toggle_split_zoom

# Quick terminal (dropdown)
keybind = cmd+grave_accent=toggle_quick_terminal

# Divers
keybind = cmd+shift+e=equalize_splits
keybind = cmd+r=reset
